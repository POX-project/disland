<!-- Feature-preserving: backups stay disabled via allowBackup=false in the manifest.
     These rules are defense-in-depth so notification history (SQLite) and settings
     (DataStore/sharedpref) are NEVER uploaded even if backup is re-enabled later. -->
<full-backup-content>
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="file"
        path="." />
</full-backup-content>
